# Vite emits imported assets with content hashes, so these URLs are safe to cache
# for a year. A changed file receives a new URL on the next build.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/optimized-images/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the SPA document revalidatable so deployments are picked up promptly.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
